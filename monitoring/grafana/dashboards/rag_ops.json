{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "title": "CryptoStream AI - RAG Ops",
  "uid": "cryptostream-rag-ops",
  "description": "RAG latency, estimated AI cost, A/B retrieval arms, feedback quality, and annotation queue monitoring.",
  "tags": ["cryptostream", "rag", "ai-cost", "latency"],
  "schemaVersion": 38,
  "refresh": "15s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "tenant",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(cryptostream_rag_retrievals_total, tenant_id)",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "current": { "text": "public", "value": "public" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "RAG Retrievals",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "cryptostream_rag_retrievals_total{tenant_id=\"$tenant\"}",
          "legendFormat": "retrievals"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Estimated AI Cost",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 6, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.05 }, { "color": "red", "value": 0.5 }] } } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "cryptostream_rag_estimated_cost_usd_total{tenant_id=\"$tenant\"}",
          "legendFormat": "estimated cost"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "P95 Latency",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "ms", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1200 }, { "color": "red", "value": 2000 }] } } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "cryptostream_rag_latency_p95_ms{tenant_id=\"$tenant\"}",
          "legendFormat": "p95 latency"
        }
      ]
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Negative Feedback Ratio",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": true, "showThresholdMarkers": true },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.2 }, { "color": "red", "value": 0.3 }] } } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "cryptostream_rag_feedback_negative_ratio",
          "legendFormat": "negative ratio"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latency Trend",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "cryptostream_rag_latency_avg_ms{tenant_id=\"$tenant\"}",
          "legendFormat": "avg"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "cryptostream_rag_latency_p95_ms{tenant_id=\"$tenant\"}",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Estimated Cost Trend",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 6 } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "cryptostream_rag_estimated_cost_usd_total{tenant_id=\"$tenant\"}",
          "legendFormat": "cumulative"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "increase(cryptostream_rag_estimated_cost_usd_total{tenant_id=\"$tenant\"}[1h])",
          "legendFormat": "last hour"
        }
      ]
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "A/B Arm Retrievals",
      "gridPos": { "x": 0, "y": 12, "w": 8, "h": 7 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "cryptostream_rag_experiment_retrievals_total{tenant_id=\"$tenant\"}",
          "legendFormat": "{{ arm }}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "A/B Arm Avg Latency",
      "gridPos": { "x": 8, "y": 12, "w": 8, "h": 7 },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "cryptostream_rag_experiment_latency_avg_ms{tenant_id=\"$tenant\"}",
          "legendFormat": "{{ arm }}"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Annotation Queue",
      "gridPos": { "x": 16, "y": 12, "w": 4, "h": 7 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 20 }, { "color": "red", "value": 50 }] } } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "cryptostream_rag_annotation_queue_items{tenant_id=\"$tenant\"}",
          "legendFormat": "items"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Embedded Chunks",
      "gridPos": { "x": 20, "y": 12, "w": 4, "h": 7 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "cryptostream_rag_embedded_chunks_total",
          "legendFormat": "embedded chunks"
        }
      ]
    }
  ]
}
