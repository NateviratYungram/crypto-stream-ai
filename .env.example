# ============================================================
# CryptoStream AI — Environment Template
# Copy this file to .env and fill in real values.
# NEVER commit your actual .env file to git.
# ============================================================

# ── AI Intelligence ─────────────────────────────────────────
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE
MODEL_ID=gemini-2.5-flash

# ── Database ────────────────────────────────────────────────
POSTGRES_USER=user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=crypto_stream_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crypto_stream_db
DB_USER=user
DB_PASS=CHANGE_ME_STRONG_PASSWORD_HERE

# ── Kafka ───────────────────────────────────────────────────
KAFKA_BROKER=localhost:9092

# ── Security & Auth ─────────────────────────────────────────
# Generate with: openssl rand -hex 32
MCP_API_KEY=CHANGE_ME_32_CHAR_RANDOM_STRING
APP_API_KEY=CHANGE_ME_32_CHAR_RANDOM_STRING

# JWT Secret for user auth (Phase 16) — generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_RANDOM_JWT_SECRET_HERE

# ── Airflow ─────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=CHANGE_ME_FERNET_KEY_HERE

# ── Grafana ─────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# RAG cost/latency monitoring
# Cost is an estimate for local dashboards; reconcile real spend with provider billing.
RAG_METRICS_TENANTS=public
RAG_ESTIMATED_EMBED_COST_PER_1K=0.0001

# ── GCP (Optional — for BigQuery Archive) ───────────────────
# Ensure gcp-key.json is in .gitignore (already done)
# Bucket selection is currently configured via Airflow Variable `gcs_bucket_name`.

# ── Rate Limiting ───────────────────────────────────────────
CHAT_RATE_LIMIT=10/minute

# ── Notifications (Phase 14) ────────────────────────────────
# Telegram Bot: create via @BotFather, get Chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE
TELEGRAM_ALLOWED_CHAT_IDS=YOUR_CHAT_ID_HERE
TELEGRAM_BOT_POLLING_ENABLED=1
ANOMALY_NOTIFY_CRITICAL=1

# Coinglass API (optional — enhances liquidation heatmap with real data)
# Get free key at https://coinglass.com/pricing
COINGLASS_API_KEY=

# Finnhub API (optional — enables earnings calendar)
# Get free key at https://finnhub.io/
FINNHUB_API_KEY=

# ML readiness / MT5 broker-history controls
# ML_TRAIN_USE_MT5=1 makes training prefer broker MT5 history even for deep backtests.
ML_TRAIN_USE_MT5=0
ML_REQUIRE_MT5_AUDIT_FOR_LIVE=0
ML_READY_MIN_PAPER_LABELS=40
ML_READY_MIN_MODEL_SAMPLES=1500
ML_READY_MIN_HOLDOUT_AUC=0.503
ML_READY_MIN_WALK_FORWARD_AUC=0.510
ML_READY_MIN_PROFIT_FACTOR=1.20
ML_READY_MIN_EXPECTANCY_USD=0.0
ML_READY_MAX_BRIER=0.30
ML_MODEL_MIN_PROMOTION_AUC=0.50
ML_MODEL_MIN_PROMOTION_ACCURACY=0.35
ML_MODEL_PROMOTION_ACCURACY_TOLERANCE=0.005
ML_MODEL_PROMOTION_MIN_AUC_IMPROVEMENT=0.005
ML_MODEL_PROMOTION_MAX_ACCURACY_REGRESSION=0.032
# Runtime state:
# - If HOST_APP_DATA_DIR is omitted, Docker Compose now uses its own named volume (`app_runtime_data`)
#   so SQLite/watchlists survive restarts without touching OneDrive.
# - Only set HOST_APP_DATA_DIR if you explicitly want a host path, and make sure it is NOT under
#   OneDrive / Dropbox / Google Drive.
HOST_APP_DATA_DIR=
# Optional override for non-Docker local runs. Inside Docker the service uses /app/data/persistence.db.
PAPER_TRADE_DB=
# Emergency override only. Keep this 0 unless you explicitly accept live risk.
ALLOW_UNREADY_LIVE_TRADING=0

# Live trading runtime
# MetaTrader5 must be installed, logged in, and reachable from the runtime host.
# Keep live trading disabled until /api/system/readiness reports ready_for_live_trading=true.
MT5_ENABLED=0
MT5_TERMINAL_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_BRIDGE_URL=http://host.docker.internal:8765
MT5_BRIDGE_API_KEY=CHANGE_ME_LOCAL_MT5_BRIDGE_KEY
MT5_BRIDGE_TIMEOUT=8
MT5_BRIDGE_HOST=0.0.0.0
MT5_BRIDGE_PORT=8765
# Keep 0 until account/quote checks pass. Set to 1 only when you accept live order risk.
MT5_BRIDGE_ENABLE_LIVE_TRADING=0
MT5_REQUIRE_STOP_LOSS=1
MT5_MAX_LIVE_VOLUME=0.10
MT5_BRIDGE_REQUIRE_SL=1
MT5_BRIDGE_MAX_LIVE_VOLUME=0.10

# Automated paper/shadow labels for no-cost ML quality improvement.
AUTO_PAPER_ENABLED=1
AUTO_PAPER_SHADOW_LABELING_ENABLED=1
AUTO_PAPER_SHADOW_LABEL_MAX_AGE_MINUTES=60
AUTO_PAPER_COOLDOWN_MINUTES=5
AUTO_PAPER_MAX_OPEN_POSITIONS=8
AUTO_PAPER_SCAN_INTERVAL_SECONDS=30
