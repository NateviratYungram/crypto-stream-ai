# ============================================================
# CryptoStream AI — Environment Template
# Copy this file to .env and fill in real values.
# NEVER commit your actual .env file to git.
# ============================================================

# ── AI Intelligence ─────────────────────────────────────────
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE
MODEL_ID=gemini-2.5-flash

# ── Database ────────────────────────────────────────────────
POSTGRES_USER=user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=crypto_stream_db

# ── Kafka ───────────────────────────────────────────────────
KAFKA_BROKER=localhost:9092

# ── Security & Auth ─────────────────────────────────────────
# Generate with: openssl rand -hex 32
MCP_API_KEY=CHANGE_ME_32_CHAR_RANDOM_STRING
APP_API_KEY=CHANGE_ME_32_CHAR_RANDOM_STRING

# JWT Secret for user auth (Phase 16) — generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_RANDOM_JWT_SECRET_HERE

# ── Airflow ─────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=CHANGE_ME_FERNET_KEY_HERE

# ── Grafana ─────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ── GCP (Optional — for BigQuery Archive) ───────────────────
# Ensure gcp-key.json is in .gitignore (already done)
GCS_BUCKET_NAME=crypto-stream-lake-01
GCP_PROJECT_ID=your-project-id

# ── Rate Limiting ───────────────────────────────────────────
CHAT_RATE_LIMIT=10/minute

# ── Notifications (Phase 14) ────────────────────────────────
# Telegram Bot: create via @BotFather, get Chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# Line Notify: get token at https://notify-bot.line.me/my/
LINE_NOTIFY_TOKEN=YOUR_LINE_NOTIFY_TOKEN_HERE

# TradingView Webhook: set any secret string, then put it in TV alert JSON as "secret"
TV_WEBHOOK_SECRET=CHANGE_ME_RANDOM_SECRET_HERE

# Coinglass API (optional — enhances liquidation heatmap with real data)
# Get free key at https://coinglass.com/pricing
COINGLASS_API_KEY=

# Finnhub API (optional — enables earnings calendar)
# Get free key at https://finnhub.io/
FINNHUB_API_KEY=
